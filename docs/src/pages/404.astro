---
import Layout from '@/layouts/Layout.astro';
---

<Layout lang="en" title="Not found">
  <main class="flex flex-1 flex-col items-center justify-center gap-4 text-center">
    <h1 class="text-3xl font-bold">404</h1>
    <p class="text-fd-muted-foreground">This page does not exist.</p>
    <a class="rounded-full bg-fd-primary px-5 py-2.5 text-sm font-medium text-fd-primary-foreground" href="/docs">
      Open the documentation
    </a>
  </main>
</Layout>
