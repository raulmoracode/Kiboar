# Copy to .env.local and fill the publishable key from the Medusa admin.
# Publishable keys are public; they scope the Store API to a sales channel.
VITE_MEDUSA_URL=http://localhost:9000
VITE_MEDUSA_PUBLISHABLE_KEY=
# Optional: pin the storefront to one Medusa region. Without it, the first
# published region is used, and prices fall back to the product currency.
VITE_REGION_ID=
