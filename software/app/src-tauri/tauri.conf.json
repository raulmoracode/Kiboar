{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiboar Studio",
  "version": "0.1.0",
  "identifier": "com.github.raulmoracode.kiboarstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kiboar Studio",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Safe firmware flasher for Kiboar keyboards",
    "longDescription": "Kiboar Studio detects an RP2040 bootloader, verifies a UF2 and writes it with an explicit confirmation. This build is unsigned and intended for testers.",
    "resources": {
      "../../registry": "registry",
      "../../boards": "boards"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
