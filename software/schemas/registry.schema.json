{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiboar:registry:1",
  "title": "Kiboar board registry",
  "description": "The boards, MCUs and signed firmware artefacts the application can offer.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "kiboar.registry/1"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "mcus": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
          },
          "family": {
            "type": "string",
            "enum": [
              "rp2040"
            ]
          },
          "bootloader": {
            "type": "object",
            "properties": {
              "vid": {
                "type": "string",
                "pattern": "^[0-9a-f]{4}$"
              },
              "pid": {
                "type": "string",
                "pattern": "^[0-9a-f]{4}$"
              }
            },
            "required": [
              "vid",
              "pid"
            ],
            "additionalProperties": false
          },
          "flash_kb": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 65536
          }
        },
        "required": [
          "id",
          "family",
          "bootloader",
          "flash_kb"
        ],
        "additionalProperties": false
      }
    },
    "boards": {
      "minItems": 1,
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
          },
          "hw_rev": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "board_id",
          "hw_rev",
          "definition"
        ],
        "additionalProperties": false
      }
    },
    "firmware": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "board_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
          },
          "hw_rev": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096
          }
        },
        "required": [
          "board_id",
          "hw_rev",
          "version",
          "path",
          "sha256",
          "signature"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "generated",
    "mcus",
    "boards",
    "firmware"
  ],
  "additionalProperties": false
}
